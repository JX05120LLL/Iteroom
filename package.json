{
  "name": "iteroom",
  "version": "0.1.0-dev.0",
  "private": true,
  "type": "module",
  "description": "Local code workbench built on the DeepSeek Harness execution engine",
  "bin": {
    "iteroom": "./bin/iteroom.mjs"
  },
  "files": [
    "bin/iteroom.mjs",
    "lib/index.js",
    "lib/client.js",
    "lib/host/task-store.js",
    "lib/host/workspace-evidence.js",
    "lib/host/managed-task-store.js",
    "lib/host/managed-task-route.js",
    "lib/host/managed-read-scope.js",
    "lib/host/managed-snapshot.js",
    "lib/host/managed-engine-plugin.js",
    "lib/host/managed-engine-profile.js",
    "lib/host/managed-engine-runner.js",
    "lib/host/managed-model-guard.js",
    "lib/host/managed-task-coordinator.js",
    "lib/host/managed-model-key.js",
    "lib/host/managed-artifact.js",
    "lib/host/managed-acceptance.js",
    "lib/host/managed-history.js",
    "lib/host/managed-sandbox.js",
    "lib/host/managed-modify-plugin.js",
    "lib/host/managed-modify-coordinator.js",
    "iteroom.patch.yml"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build-ui.mjs",
    "prepack": "npm run build",
    "start": "node bin/iteroom.mjs",
    "review": "node scripts/review.mjs",
    "check": "tsc --noEmit",
    "test": "node --test test/launcher.test.js test/task-store.test.js test/workspace-evidence.test.js test/managed-task-store.test.js test/managed-task-route.test.js test/managed-read-scope.test.js test/managed-snapshot.test.js test/managed-engine.test.js test/managed-model-guard.test.js test/managed-task-coordinator.test.js test/managed-model-key.test.js test/managed-crash-recovery.test.js test/managed-modify-store.test.js test/managed-sandbox.test.js test/managed-artifact.test.js test/managed-modify-coordinator.test.js test/managed-modify-route.test.js test/managed-acceptance.test.js test/managed-history.test.js",
    "test:web": "node test/web-smoke.mjs",
    "test:launcher": "node --test test/launcher.test.js"
  },
  "dependencies": {
    "@alibaba-group/opensandbox": "1.1.0",
    "@deepseek-ai/cordis-plugin-group": "1.0.2",
    "@deepseek-ai/dsh": "0.1.5-rc.3",
    "@deepseek-ai/dsh-llm-deepseek": "0.1.5-rc.3",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.3"
  },
  "devDependencies": {
    "@types/react": "18.3.28",
    "esbuild": "0.25.12",
    "lightningcss": "1.30.2",
    "react": "18.3.1",
    "typescript": "5.9.3"
  }
}
